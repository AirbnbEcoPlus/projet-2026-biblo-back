{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Nouvel emprunt (formulaire manuel){% endblock %}

{% block page_actions %}
    <a class="btn btn-secondary" href="{{ ea_url().setController('App\\Controller\\Admin\\EmpruntCrudController').setAction('index') }}">
        Retour a la liste
    </a>
{% endblock %}

{% block main %}
    <div class="container-fluid px-0">
        <div class="alert alert-info mb-4" role="alert">
            Selectionne un adherent et un ou plusieurs livres disponibles. La limite de 5 emprunts en cours est verifiee automatiquement.
        </div>

        {{ form_start(form) }}
            <div class="row g-4 align-items-start">
                <div class="col-12 col-xl-7">
                    <div class="card shadow-sm border-0">
                        <div class="card-header fw-semibold">Saisie</div>
                        <div class="card-body d-grid gap-3">
                            {{ form_row(form.adherent) }}

                            <div>
                                {{ form_label(form.livres) }}
                                {{ form_widget(form.livres, { attr: { class: 'form-select', size: 8 } }) }}
                                {{ form_help(form.livres) }}
                                {{ form_errors(form.livres) }}
                                <div class="form-text">Astuce: maintiens Ctrl (ou Cmd) pour selectionner plusieurs livres.</div>
                            </div>

                            {{ form_row(form.dateRetour) }}
                        </div>
                        <div class="card-footer bg-transparent border-0 pt-0 pb-3 px-3">
                            <button class="btn btn-primary btn-lg" type="submit">Enregistrer les emprunts</button>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-xl-5">
                    <div class="card shadow-sm border-0 mb-3">
                        <div class="card-header fw-semibold">Adherent selectionne</div>
                        <div class="card-body" id="adherent-info">
                            <p class="text-body-secondary mb-0">Choisis un adherent pour afficher ses informations.</p>
                        </div>
                    </div>

                    <div class="card shadow-sm border-0">
                        <div class="card-header fw-semibold">Livres selectionnes</div>
                        <div class="card-body" id="books-info">
                            <p class="text-body-secondary mb-0">Aucun livre selectionne.</p>
                        </div>
                    </div>
                </div>
            </div>
        {{ form_end(form) }}
    </div>

    <script>
        (function () {
            const adherentSelect = document.getElementById('{{ form.adherent.vars.id }}');
            const booksSelect = document.getElementById('{{ form.livres.vars.id }}');
            const adherentInfo = document.getElementById('adherent-info');
            const booksInfo = document.getElementById('books-info');

            if (!adherentSelect || !booksSelect || !adherentInfo || !booksInfo) {
                return;
            }

            const renderAdherentInfo = () => {
                const selected = adherentSelect.options[adherentSelect.selectedIndex];
                if (!selected || !selected.value) {
                    adherentInfo.innerHTML = '<p class="text-body-secondary mb-0">Choisis un adherent pour afficher ses informations.</p>';
                    return;
                }

                const active = selected.dataset.activeLoans || '0';
                const slots = selected.dataset.remainingSlots || '5';
                const email = selected.dataset.email || 'Non renseigne';
                const phone = selected.dataset.phone || 'Non renseigne';

                adherentInfo.innerHTML =
                    '<ul class="list-group list-group-flush">' +
                    '<li class="list-group-item px-0 d-flex justify-content-between"><span>Emprunts en cours</span><span class="badge bg-primary-subtle text-primary-emphasis">' + active + ' / 5</span></li>' +
                    '<li class="list-group-item px-0 d-flex justify-content-between"><span>Places restantes</span><span class="badge bg-success-subtle text-success-emphasis">' + slots + '</span></li>' +
                    '<li class="list-group-item px-0"><strong>Email:</strong> ' + email + '</li>' +
                    '<li class="list-group-item px-0"><strong>Telephone:</strong> ' + phone + '</li>' +
                    '</ul>';
            };

            const renderBooksInfo = () => {
                const selected = Array.from(booksSelect.selectedOptions || []);

                if (selected.length === 0) {
                    booksInfo.innerHTML = '<p class="text-body-secondary mb-0">Aucun livre selectionne.</p>';
                    return;
                }

                const lines = selected.map((option) => {
                    const langue = option.dataset.langue || 'Non renseignee';
                    const auteurs = option.dataset.auteurs || 'Non renseignes';
                    const dateSortie = option.dataset.dateSortie || 'Non renseignee';

                    return '<li class="list-group-item px-0">' +
                        '<div class="fw-semibold mb-1">' + option.text + '</div>' +
                        '<div class="small text-body-secondary">Langue: ' + langue + '</div>' +
                        '<div class="small text-body-secondary">Auteurs: ' + auteurs + '</div>' +
                        '<div class="small text-body-secondary">Sortie: ' + dateSortie + '</div>' +
                        '</li>';
                });

                booksInfo.innerHTML = '<ul class="list-group list-group-flush">' + lines.join('') + '</ul>';
            };

            adherentSelect.addEventListener('change', renderAdherentInfo);
            booksSelect.addEventListener('change', renderBooksInfo);
            renderAdherentInfo();
            renderBooksInfo();
        })();
    </script>
{% endblock %}
